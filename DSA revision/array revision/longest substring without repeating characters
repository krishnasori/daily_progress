class Solution {
public:
    int lengthOfLongestSubstring(string s) {
        unordered_set<char>st;
        int len,max_len=0;
        int j=0;
        if(s.size()==0){
            return 0;
        }
        for(int i=0;i<s.length();i++){
            
            if(!st.count(s[i])){
                st.insert(s[i]);
                len=st.size();
                max_len=max(len,max_len);
            }
            else{
              
                while(j<=i ){
                    if(st.count(s[i]) && !st.empty()){
                        st.erase(s[j]);
                        j++;
                    }
                    else {
                        break;
                    }
                }
                st.insert(s[i]);
            }
        }
   
        return max_len;
     
    }
};
